# Kopieren nach .env und ausfüllen
TZ=Europe/Berlin

# Präfix der Container-Namen (verhindert Namenskonflikte mit anderen Stacks im selben Docker-Netz).
# Im Proxy-Host bzw. Caddyfile heißt der Forgejo-Container dann ${STACK_NAME}, Uptime Kuma ${STACK_NAME}-uptime-kuma.
# Das Netz "forgejo-ci" (runner-config.yml) bleibt fest benannt.
STACK_NAME=forgejo

# --- Forgejo ---
FORGEJO_DOMAIN=git.example.com
FORGEJO_SSH_PORT=2222
# Aktuelle Version bzw. LTS-Tag auf https://codeberg.org/forgejo/forgejo/releases prüfen
FORGEJO_VERSION=11
POSTGRES_PASSWORD=bitte-langes-zufaelliges-passwort
# Admin-Zugang, wird beim ersten Start automatisch angelegt ("admin" ist als Name reserviert)
FORGEJO_ADMIN_USER=forgejo-admin
FORGEJO_ADMIN_PASSWORD=bitte-langes-zufaelliges-passwort
FORGEJO_ADMIN_EMAIL=admin@example.com

# --- Netzwerk (Name des Docker-Netzes, in dem dein NPM bzw. Caddy hängt) ---
PROXY_NETWORK=proxy

# --- Caddy (nur bei Verwendung von compose.caddy.yml, sonst leer lassen) ---
# Domain für Uptime Kuma, z.B. status.example.com
STATUS_DOMAIN=
# E-Mail für das Let's-Encrypt-Konto
ACME_EMAIL=
# Caddy-Dateien aktivieren (Zeile einkommentieren; sonst gilt nur compose.yml)
#COMPOSE_FILE=compose.yml:compose.caddy.yml

# --- Runner ---
# Aktuellen Tag auf https://code.forgejo.org/forgejo/-/packages/container/runner prüfen
RUNNER_VERSION=11
RUNNER_NAME=runner-1
# Der Registrierungs-Token wird automatisch erzeugt (./secrets/runner)

# --- Renovate ---
# Benutzer "renovate-bot" und sein Access-Token (repository rw, issue rw, user r,
# organization r) werden automatisch angelegt (./secrets/renovate)
# optional, vermeidet GitHub-Rate-Limits beim Abrufen von Changelogs
RENOVATE_GITHUB_COM_TOKEN=

# --- Backup (restic) ---
# Beispiel S3:       s3:https://s3.example.com/bucket-name
# Beispiel SFTP:     sftp:u12345@u12345.your-storagebox.de:/restic
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
