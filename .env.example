# Kopieren nach .env und ausfüllen
TZ=Europe/Berlin

# --- Forgejo ---
FORGEJO_DOMAIN=git.example.com
FORGEJO_SSH_PORT=2222
# Aktuelle Version bzw. LTS-Tag auf https://codeberg.org/forgejo/forgejo/releases prüfen
FORGEJO_VERSION=11
POSTGRES_PASSWORD=bitte-langes-zufaelliges-passwort

# --- Netzwerk (Name des Docker-Netzes, in dem dein NPM hängt) ---
PROXY_NETWORK=proxy

# --- Runner (Profil "ci") ---
# Aktuellen Tag auf https://code.forgejo.org/forgejo/-/packages/container/runner prüfen
RUNNER_VERSION=11
RUNNER_NAME=runner-1
# Forgejo: Admin > Actions > Runners > "Runner erstellen" > Registrierungs-Token
RUNNER_TOKEN=

# --- Renovate (Profil "ci") ---
# Forgejo-Benutzer "renovate-bot" anlegen, Zugriffstoken mit Rechten:
# repository (read/write), issue (read/write), user (read), organization (read)
RENOVATE_TOKEN=
RENOVATE_GITHUB_COM_TOKEN=

# --- Backup (restic) ---
# Beispiel S3:       s3:https://s3.example.com/bucket-name
# Beispiel SFTP:     sftp:u12345@u12345.your-storagebox.de:/restic
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
